# Copy this file to .env and fill in your values
# cp .env.example .env

POSTGRES_PASSWORD=supersecret_change_me

# Your corporate API keys (these stay LOCAL, never sent to clients)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Test API Keys (pre-loaded in seed data) ───────────────────────────────
# Use these to call the proxy during development:
#
#   Engineering team (can use GPT-4o, Claude Sonnet, GPT-4o-mini, Haiku):
#   Authorization: Bearer aig_sk_eng_test1234567890
#
#   Marketing team (can use GPT-4o-mini and Haiku only):
#   Authorization: Bearer aig_sk_mkt_test1234567890

# ─── Alerts — Email (optional) ────────────────────────────────────────────────
# If set, Stratum will send email alerts when teams hit budget/quota thresholds.
# Works with any SMTP provider: Gmail, SendGrid, Mailgun, your own server, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=Stratum Alerts <alerts@yourcompany.com>

# Slack alerts use per-alert webhook URLs configured in the dashboard — no env var needed.

# Ollama local models (no real key needed — any value works)
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2:1b  # model used for context compression

# Dashboard session security
SESSION_SECRET=change-this-to-a-random-secret-in-production
